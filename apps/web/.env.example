# Server-only Express origin; browser requests always use /api/v1.
# Required explicitly for production build/start; use a non-public API service.
API_INTERNAL_ORIGIN=http://127.0.0.1:4000
# Public same-origin base used for canonical and sitemap URLs.
# Required explicitly as HTTPS in production build/start (this is a dev template).
WEB_ORIGIN=http://localhost:3000

