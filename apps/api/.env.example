HOST=127.0.0.1
PORT=4000
NODE_ENV=development
# Required: generate 32 random bytes as 64 hex characters; never use this placeholder.
AUTH_JWT_SECRET=replace-with-64-random-hex-characters
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://marthub:marthub@127.0.0.1:5432/marthub

# Server-only integer VND policy; free shipping at merchandise subtotal >= threshold.
SHIPPING_FIXED_FEE_VND=30000
SHIPPING_FREE_THRESHOLD_VND=500000

# Cloudinary credentials remain server-side. Use a non-production account for local development.
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
